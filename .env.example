# Copy to .env.local (never commit it). On Cloudflare, set the two SUPABASE values as secrets.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Secret key (sb_secret_...). Server only: never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Keep false until an approved privacy notice is published and linked from the form.
NEXT_PUBLIC_FORM_SUBMISSIONS_ENABLED=false
# Keep false until launch sign-off. Any other value leaves every page noindex.
NEXT_PUBLIC_INDEXING_ENABLED=false
