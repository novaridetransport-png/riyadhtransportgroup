# Copy to .env.local (never commit it). On Cloudflare, set the two SUPABASE values as secrets.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Secret key (sb_secret_...). Server only: never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Publishable key (sb_publishable_...), used by the admin area. Database rules limit what it can do.
SUPABASE_PUBLISHABLE_KEY=
# Brevo: emails the owner about new inquiries. The sender must be verified in Brevo.
BREVO_API_KEY=
NOTIFY_FROM_EMAIL=
NOTIFY_TO_EMAIL=
# Keep false until an approved privacy notice is published and linked from the form.
NEXT_PUBLIC_FORM_SUBMISSIONS_ENABLED=false
# Keep false until launch sign-off. Any other value leaves every page noindex.
NEXT_PUBLIC_INDEXING_ENABLED=false
# Shows the call and WhatsApp buttons and the phone number.
NEXT_PUBLIC_CONTACT_ENABLED=false
