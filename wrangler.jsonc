{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "riyadhtransportgroup",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "routes": [
    { "pattern": "riyadhtransportgroup.com", "custom_domain": true },
    { "pattern": "www.riyadhtransportgroup.com", "custom_domain": true }
  ],
  "triggers": { "crons": ["17 0 * * *"] },
  "ratelimits": [
    { "name": "INQUIRY_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "images": { "binding": "IMAGES" }
}
